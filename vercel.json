{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.fruteriadelbarri.online"
        }
      ],
      "destination": "https://fruteriadelbarri.online/:path*",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/"
    }
  ]
}
